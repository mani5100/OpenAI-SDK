# OpenAI Configuration
# ====================
# Your OpenAI API key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI chat model to use (optional, default: gpt-4o-mini)
# Options: gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini, gpt-3.5-turbo, etc.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Name for the OpenAI assistant (optional, default: Helpful Assistant)
OPENAI_ASSISTANT_NAME=Helpful Assistant

# Instructions for the assistant's behavior (optional)
OPENAI_ASSISTANT_INSTRUCTIONS=You are a helpful assistant.

# Temperature for response randomness (optional, default: 0.7)
# Range: 0.0 (deterministic) to 2.0 (very creative)
OPENAI_TEMPERATURE=0.7

# Maximum tokens for responses (optional, default: None/unlimited)
# Set a limit to control response length and costs
# OPENAI_MAX_TOKENS=2000


# Database Configuration
# ======================
# PostgreSQL database connection URL (required)
# Format: postgresql://username:password@host:port/database
# For async operations, you can also use: postgresql+asyncpg://username:password@host:port/database
POSTGRES_URL=postgresql://username:password@localhost:5432/chatbot_db


# API Server Configuration
# =========================
# Host to bind the API server (optional, default: 0.0.0.0)
API_HOST=0.0.0.0

# Port to bind the API server (optional, default: 8000)
API_PORT=8000

# Enable auto-reload in development (optional, default: true)
API_RELOAD=true


# CORS Configuration
# ==================
# Allowed CORS origins (optional, default: *)
# For production, specify allowed origins separated by commas
# Example: http://localhost:3000,https://myapp.com
CORS_ORIGINS=*


# Application Configuration
# ==========================
# Application name (optional, default: OpenAI Chatbot API)
APP_NAME=OpenAI Chatbot API

# Application version (optional, default: 1.0.0)
APP_VERSION=1.0.0

# Application description (optional)
APP_DESCRIPTION=A FastAPI-based chatbot service using OpenAI Agents SDK with conversation history persistence


# Logging Configuration
# ======================
# Logging level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
